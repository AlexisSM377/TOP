---
import TicketSpotify from "@/components/TicketSpotify.astro";
import { TicketHomeE } from "./ticket-home";
import TicketHome from "./ticketHome.astro";
import Trench from "@/icons/Trench.astro";
import { Container3D } from "@/components/Container3D";
---

<section
  class="relative px-4 pb-20 before:bg-gradient-to-b before:from-[#231F20] before:via-[#231F20] before:-z-10 before:inset-0 before:to-[#000] before:size-full before:absolute inset-0 m-auto"
>
  <div class="max-w-5xl mx-auto">
    <h2
      class="animate-fade-in-up text-5xl sm:text-6xl md:text-[80px] mx-auto text-center max-w-[20ch] text-white font-bold pt-60 pb-4 text-balance"
    >
      CLANCY
    </h2>
    <h3 class="text-yellow-300 text-lg text-center pb-4">Twenty One Pilots</h3>
    <hr class="pt-8 mt-16" />
    <Container3D>
      <TicketSpotify
        number={12345}
        flavor={{
          icon: Trench,
          colorPalete: {
            bg: "bg-[#007acc]/50",
            border: {
              inside: "border-blue-300/20",
              outside: "border-blue-400/10",
            },
            shadowColor: "shadow-blue-400/25",
          },
        }}
        user={{
          username: "AlexisSM377",
          avatar: "https://unavatar.io/github/AlexisSM377",
        }}
      />
    </Container3D>
  </div>
</section>

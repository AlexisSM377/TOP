---
import Container3D from "@/components/Container3D.astro";
import { Image } from "astro:assets";
import myImportedImage from "/public/img/clancy-hero-banner.jpg";
import TicketSpotify from "@/components/TicketSpotify.astro";
import Twenty from "@/icons/Twenty.astro";
---

<div>
  <div class="block w-full h-full">
    <div
      class="flex items-center justify-center max-w-[700px] mx-auto mt-16 flex-0"
    >
      <Container3D>
        <TicketSpotify
          number={12345}
          flavor={{
            icon: Twenty,
            colorPalete: {
              bg: "bg-[#ffffff]/80",
              border: {
                outside: "border-white-200/10",
                inside: "border-white-400/10",
              },
              shadowColor: "shadow-white-400/25",
            },
          }}
          user={{
            username: "AlexisSM377",
            avatar: "https://unavatar.io/github/AlexisSM377",
          }}
        />
        <Image
          class="block w-full h-auto mx-auto md:aspect-[2/1] [box-sizing:border-box] relative z-[1000]"
          src={myImportedImage}
          alt="Clancy"
        />
        <p>Alexis</p>
      </Container3D>
    </div>
  </div>
</div>

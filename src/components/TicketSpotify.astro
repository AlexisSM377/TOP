---
import Top from "./top.astro";
import "atropos/css";

interface Props {
  transition?: boolean;
  number: number;
  class?: string;
  flavor: {
    icon: any;
    colorPalete: {
      bg: string;
      border: {
        outside: string;
        inside: string;
      };
      shadowColor: string;
    };
  };
  user: {
    username: string;
    avatar: string;
  };
  isSizeFixed?: boolean;
}

const {
  transition = true,
  number,
  class: className,
  flavor: { icon: Icon, colorPalete },
  user: { username, avatar },
  isSizeFixed = false,
} = Astro.props;

const ticketNumber = `#${number != null ? number.toString().padStart(5, "0") : ""}`;

const currentTicketStyles = {
  backgroundColor: colorPalete?.bg ?? "bg-[#101E5B]/65",
  borderColor: {
    outside: colorPalete?.border.outside ?? "border-top-primary/10",
    inside: colorPalete?.border.inside ?? "border-top-primary/20",
  },
  shadowColor: colorPalete?.shadowColor ?? "shadow-top-primary/25",
};
---

<div
  class:list={[
    "block h-full overflow-hidden opacity-100 rounded-[60px] shadow-[inset_0_4px_30px] bg-transparent border p-5",
    isSizeFixed ? "aspect-[2/1] w-full" : "aspect-none w-full md:aspect-[2/1]",
    currentTicketStyles.borderColor.outside,
    currentTicketStyles.shadowColor,
    transition ? "transition duration-500 ease-in-out" : "",
    className,
  ]}
>
  <div
    class:list={[
      "relative h-full overflow-hidden border rounded-[40px]",
      isSizeFixed ? "flex" : "grid md:flex",
      currentTicketStyles.backgroundColor,
      currentTicketStyles.borderColor.inside,
      transition ? "transition duration-500 ease-in-out" : "",
    ]}
  >
    <div
      class="absolute w-1/2 rotate-45 h-[300%] left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 bg-gradient-to-r from-[#41b3ff00] via-[#b0a9ff13] to-[#41b3ff00]"
    >
      <span
        class:list={[
          "h-full font-mono text-center text-white font-bold",
          isSizeFixed
            ? "ticket-dash-border px-4 text-3xl py-0 leading-none [writing-mode:vertical-lr]"
            : "ticket-dash-border-top row-[3/4] px-4 py-4 md:py-0 text-4xl md:px-4 md:text-3xl md:[writing-mode:vertical-lr] md:ticket-dash-border",
        ]}
      >
        {ticketNumber}
      </span>
      <div
        class:list={[
          "-rotate-12",
          isSizeFixed
            ? "absolute bottom-[20%] left-[25%] mb-0 h-[40%] w-auto block"
            : "md:w-auto row-[2/3] mb-8 md:mb-0 left-0 mx-auto md:mx-0 h-32 md:h-[40%] relative flex justify-center w-full md:block bottom-0 md:left-[25%] md:bottom-[20%]  md:absolute",
        ]}
      >
        <Icon class="absolute w-auto h-full" />
      </div>
      <div
        class:list={[
          "z-10 grid w-full grid-rows-2",
          isSizeFixed
            ? "h-full pd-0 grid-rows-2"
            : "h-auto md:h-full pt-5 md:pt-0 grid-rows-[1fr_auto] md:grid-rows-2",
        ]}
      >
        <div
          class:list={["grid", isSizeFixed ? "grid-cols-2" : "md:grid-cols-2"]}
        >
          <div class="h-max">
            {
              avatar ? (
                <div
                  class:list={[
                    "flex items-end justify-start font-mono gap-4 text-white gap-y-2",
                    isSizeFixed
                      ? "items-start flex-row p-6 text-left"
                      : "p-5 flex-col md:items-start md:flex-row md:p-6 items-center text-center md:text-left",
                  ]}
                >
                  <img
                    class:list={[
                      "block rounded-full",
                      isSizeFixed
                        ? "w-[78px] h-[78px]"
                        : "w-20 h-20 md:w-[78px] md:h-[78px]",
                    ]}
                    src={avatar}
                    alt={username}
                    width="78"
                    height="78"
                  />
                  <div>
                    <p class="text-xl font-bold">Hello {username}</p>
                  </div>
                </div>
              ) : (
                <div
                  class:list={[
                    "flex items-end justify-start gap-4 text-white gap-y-2",
                    isSizeFixed
                      ? "items-start flex-row p-6 text-left"
                      : "p-5 flex-col md:items-start md:flex-row md:p-6 items-center text-center md:text-left",
                  ]}
                >
                  <div
                    class:list={[
                      "flex items-end justify-start gap-4 text-white gap-y-2",
                      isSizeFixed
                        ? "items-start flex-row p-6 text-left"
                        : "p-5 flex-col md:items-start md:flex-row md:p-6 items-center text-center md:text-left",
                    ]}
                  >
                    <div>
                      <p class="text-xl font-bold">
                        <span class="opacity-75 text-midu-primary">#</span>
                        miduConf
                      </p>
                      <span class="block text-sm font-normal w-max text-white/60">
                        Evento de Programación Gratuito
                      </span>
                    </div>
                  </div>
                </div>
              )
            }
          </div>
          <div
            class:list={[
              "items-center gap-4 p-5 flex-row",
              isSizeFixed && avatar
                ? "block"
                : `${avatar ? "hidden" : "flex"} md:block flex-col-reverse md:flex-row`,
              avatar == null,
              "hidden",
            ]}
          >
            <Top
              class:list={[
                "order-1 h-auto w-9",
                isSizeFixed ? "ml-auto" : " ml-0 md:ml-auto",
              ]}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ticket-dash-border {
    background-image: linear-gradient(
      hsla(0, 0%, 100%, 0.2) 0%,
      hsla(0, 0%, 100%, 0.2) 50%,
      transparent 50%
    );
    background-size: 0.0625rem 1.125rem;
    background-position: 100% 0;
    background-repeat: repeat-y;
  }

  .ticket-dash-border-top {
    background-image: linear-gradient(
      to right,
      hsla(0, 0%, 100%, 0.2) 0%,
      hsla(0, 0%, 100%, 0.2) 50%,
      transparent 50%
    );
    background-size: 1.125rem 0.0625rem;
    background-position: 0 0;
    background-repeat: repeat-x;
  }

  .ticket-gradient-bg {
    background: radial-gradient(
        120% 100% at 90% 10%,
        #a3d8ff 0%,
        #3640e2 23%,
        #6639d9 50%,
        #657fd8 74%,
        #95bdf4 100%
      ),
      radial-gradient(
        120% 100% at 10% 90%,
        #a3d9ff50 0%,
        #3640e250 23%,
        #6639d950 50%,
        #657fd850 74%,
        #95bdf450 100%
      );
    background-size: 200% 200%;
    background-blend-mode: multiply;
    animation: animateGradient 10s infinite alternate linear;
    z-index: 1;
  }

  .ticket-gradient-bg::after {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: 1;
    background: linear-gradient(
      -72deg,
      #ffffff 0%,
      rgb(0, 0, 0, 0) 16%,
      #ffffff 24%,
      rgb(0, 0, 0, 0) 33%,
      rgb(0, 0, 0, 0) 40%,
      #fff8f8 50%,
      rgb(0, 0, 0, 0) 61%,
      rgb(0, 0, 0, 0) 74%,
      #ffffff 83%,
      rgb(0, 0, 0, 0) 92%,
      #ffffff 100%
    );
    background-size: 200% 100%;
    opacity: 0.4;
    animation: animateLightGradient 120s infinite alternate linear;
  }

  .ticket-gradient-bg::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
    background-image: url(/public/img/tickets-effect/gradient.png);
    background-size: 50px 50px;
    opacity: 0.7;
  }

  @keyframes animateGradient {
    0% {
      background-position: 0% 0%;
    }

    25% {
      background-position: 50% 50%;
    }

    50% {
      background-position: 100% 100%;
    }

    75% {
      background-position: 50% 50%;
    }

    100% {
      background-position: 0% 0%;
    }
  }
  @keyframes animateLightGradient {
    0% {
      background-position: 0% 0%;
    }

    25% {
      background-position: 50% 0%;
    }

    50% {
      background-position: 100% 0%;
    }

    75% {
      background-position: 50% 0%;
    }

    100% {
      background-position: 0% 0%;
    }
  }
</style>
